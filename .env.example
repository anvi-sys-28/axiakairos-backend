# Axia Kairos Backend Environment Variables (Railway / Cloud Deployment)

PORT=3001
NODE_ENV=production

# OpenAI API Key (ChatGPT)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
AI_MODEL=gpt-4o-mini

# PostgreSQL Connection String (e.g. from Railway Postgres plugin)
# If left empty, backend falls back gracefully to local JSON persistent storage
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Admin Authentication
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=generate_a_random_32_character_secret_string_here

# Frontend URL for CORS (e.g. Cloudflare Pages URL)
FRONTEND_URL=https://your-frontend.pages.dev
