# ==============================================================
# AXIA KAIROS BACKEND - RAILWAY ENVIRONMENT CONFIGURATION
# ==============================================================

# Server Port (Railway automatically sets PORT)
PORT=3001
NODE_ENV=production

# Database (PostgreSQL)
# Auto-injected by Railway when PostgreSQL service is linked
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Admin Authentication Secret
ADMIN_JWT_SECRET=axia-admin-super-secret-key-2026

# Anthropic Claude API (Tool-Calling Agent)
ANTHROPIC_API_KEY=sk-ant-api03-...

# AI Model: default "claude-haiku-5-5" (or "claude-sonnet-5-5")
AI_MODEL=claude-haiku-5-5
